# GEMINI_API_KEY: Required for AI chat and daily insights.
# Get a free key at: https://aistudio.google.com/apikey
# Do NOT leave this as the placeholder — chat will not work without a real key.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE & FACEBOOK SOCIAL SIGN-IN CONFIG
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=

# SECRET CONFIGS (SERVER-ONLY)
JWT_SECRET=
DATABASE_URL=
FRONTEND_URL=

# ENCRYPTION-AT-REST KEYS (Must be exactly 32 bytes / 64 hex characters)
# Example value: 64a8b792e3d9342502ba7c182b8fde34a2e58913b8214fa8d9e234a9b2b512c9
ENCRYPTION_KEY=
